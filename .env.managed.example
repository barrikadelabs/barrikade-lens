# Copy to .env.managed.local. Never commit the local file.
LENS_JWT_SECRET=replace-with-at-least-32-random-bytes
LENS_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
LENS_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
LENS_CLERK_SECRET_KEY=sk_test_replace_me
LENS_CLERK_AUTHORIZED_PARTY=http://localhost:8080

# Clerk lifecycle reconciliation webhook (required in Clerk mode).
LENS_CLERK_WEBHOOK_SECRET=whsec_replace_me

# Cloud connectors remain unavailable until their Azure-hosted workload
# federation values are configured.
LENS_AWS_CONNECTOR_ENABLED=false
LENS_AZURE_CONNECTOR_ENABLED=false
LENS_GCP_CONNECTOR_ENABLED=false
LENS_ENDPOINT_CONNECTOR_ENABLED=true
LENS_KUBERNETES_CONNECTOR_ENABLED=false
LENS_GITHUB_CONNECTOR_ENABLED=false
LENS_ENDPOINT_HANDOFF_ENABLED=true

# Activation analytics is off until legal/privacy review and a dedicated EU
# PostHog project are complete. Use a different token and salt per environment.
LENS_POSTHOG_ENABLED=false
LENS_POSTHOG_PROJECT_TOKEN=
LENS_POSTHOG_HOST=https://eu.i.posthog.com
LENS_POSTHOG_ID_SALT=replace-with-at-least-32-random-bytes
LENS_DEPLOYMENT_ENVIRONMENT=staging
