{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.barrikade.ai/lens/detector-pack-v2.json",
  "title": "Barrikade Lens Detector Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "runtimes", "frameworks"],
  "properties": {
    "schema_version": { "const": "2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "runtimes": { "type": "array", "items": { "$ref": "#/$defs/runtime" } },
    "frameworks": { "type": "array", "items": { "$ref": "#/$defs/framework" } },
    "model_caches": { "type": "array", "items": { "$ref": "#/$defs/model_cache" } },
    "skill_roots": { "type": "array", "items": { "$ref": "#/$defs/skill_root" } },
    "extension_roots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "listeners": { "type": "array", "items": { "$ref": "#/$defs/listener" } }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "enum": ["agent_tool", "model_runtime", "host_application", "development_runtime", "unclassified"] },
        "processes": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "environment_keys": { "type": "array", "items": { "type": "string" } },
        "extension_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "install_paths": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "configs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "format", "scope"],
            "properties": {
              "path": { "type": "string" },
              "format": { "enum": ["json", "jsonc", "yaml", "yml", "toml"] },
              "scope": { "enum": ["user", "project", "system"] }
            }
          }
        },
        "skill_roots": { "type": "array", "items": { "type": "string" } },
        "agent_roots": { "type": "array", "items": { "type": "string" } },
        "model_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "port"],
            "properties": {
              "name": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "anyOf": [
        { "required": ["packages"] },
        { "required": ["language_packages"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "language_packages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "javascript": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "go": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "rust": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "jvm": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "dotnet": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "ruby": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "imports": { "type": "array", "items": { "type": "string" } },
        "language_imports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "javascript": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "go": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "rust": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "jvm": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "dotnet": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "ruby": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },
    "model_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "paths", "layout"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "layout": { "enum": ["huggingface", "ollama", "lm-studio", "directory"] }
      }
    },
    "skill_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "paths", "scope"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scope": { "enum": ["user", "project", "system"] }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "port", "processes"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["model_server", "mcp_server", "api_service"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "processes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
