{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barrikade.ai/schemas/lens/runtime-identity-observation-v0.1.json",
  "title": "Barrikade Lens Experimental Runtime Identity Observation v0.1",
  "description": "Non-authoritative discovery evidence for a running process. This document is not a Registry identity, admission, attestation, or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_id", "target_id", "product_id", "platform",
    "observed_at", "pid", "start_time", "parent_pid", "ancestry", "effective_uid",
    "version", "executable_path_digest", "executable_sha256", "macos_signing", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0-experimental"},
    "observation_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "platform": {"const": "darwin"},
    "observed_at": {"type": "string", "format": "date-time"},
    "pid": {"type": "integer", "minimum": 1},
    "start_time": {"type": "string", "format": "date-time"},
    "parent_pid": {"type": "integer", "minimum": 0},
    "ancestry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/ancestor"}
    },
    "effective_uid": {"type": "integer", "minimum": 0},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "executable_path_digest": {"$ref": "#/$defs/sha256"},
    "executable_sha256": {"$ref": "#/$defs/sha256"},
    "macos_signing": {"$ref": "#/$defs/signing"},
    "evidence": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ancestor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_time", "executable_path_digest"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_time": {"type": "string", "format": "date-time"},
        "executable_path_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_verified", "hardened_runtime", "signing_metadata_evidence_digest"],
      "properties": {
        "signature_verified": {"type": "boolean"},
        "hardened_runtime": {"type": "boolean"},
        "publisher_team_id": {"type": "string"},
        "signing_identifier": {"type": "string"},
        "cdhash": {"type": "string"},
        "designated_requirement_digest": {"$ref": "#/$defs/sha256"},
        "signing_metadata_evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "method", "observed_at"],
      "properties": {
        "fact": {"enum": ["process", "ancestry", "executable", "macos_signing"]},
        "method": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
